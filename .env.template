# Image Processor Pro Environment Configuration
# Copy this file to .env and customize your settings

# Azure Blob compatibility helper (optional). DefaultAzureCredential is used.
AZURE_STORAGE_ACCOUNT_URL=https://your_account.blob.core.windows.net
# Legacy secrets must be supplied by a local secret store and never committed:
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_CV_SUBSCRIPTION_KEY=
# AZURE_CV_ENDPOINT=

# API Configuration
API_HOST=127.0.0.1
API_PORT=5000
API_DEBUG=False
# Required before using any non-health API route. Generate a high-entropy value.
IMAGE_PROCESSOR_API_TOKEN=replace-with-a-long-random-token
# Keep false unless the authenticated API must alter in-memory settings.
IMAGE_PROCESSOR_ALLOW_CONFIG_MUTATION=false
# Request cap (bytes); base64 payloads are additionally checked after decoding.
IMAGE_PROCESSOR_MAX_UPLOAD_BYTES=52428800

# Processing Defaults
DEFAULT_QUALITY=85
DEFAULT_FORMAT=JPEG
DEFAULT_MAX_WIDTH=1920
DEFAULT_MAX_HEIGHT=1080

# Performance Settings
MAX_WORKERS=auto
ENABLE_MULTIPROCESSING=True

# Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
